VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: public app URL in login welcome emails (defaults to production)
# VITE_APP_PUBLIC_URL=https://jsjobboard.vercel.app

# Optional: used by username auth to build internal login emails (must match technicians.login_email)
# VITE_LOGIN_EMAIL_DOMAIN=users.jsvalve.local

# Employee roster logins (username@domain — default jsvalve.com per migration-employees.sql)
# VITE_EMPLOYEE_LOGIN_EMAIL_DOMAIN=jsvalve.com

# Receiving Log “Send to RFQ” email recipient (default RFQ@jsvalve.com)
# VITE_RFQ_EMAIL=RFQ@jsvalve.com

# Optional local-only admin bypass (NOT for production)
VITE_ENABLE_GENERIC_ADMIN_LOGIN=false
VITE_GENERIC_ADMIN_USERNAME=localadmin
VITE_GENERIC_ADMIN_PASSWORD=change-me

# Deprecated (older builds): VITE_GENERIC_ADMIN_EMAIL

# Optional: feedback button (on for local dev and jsjobboard.vercel.app by default)
# Set to false when you go live for customers:
# VITE_ENABLE_FEEDBACK_BUTTON=false
